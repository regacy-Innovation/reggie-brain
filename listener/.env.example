# Keep real Slack credentials in listener/.env, which is ignored by Git.
SLACK_BOT_TOKEN=replace-me
SLACK_APP_TOKEN=replace-me
SLACK_SIGNING_SECRET=replace-me
PERMITTED_SLACK_CHANNEL_ID=C074BCJGQGP
# Optional. Defaults to the repository root containing this listener.
REGGIE_BRAIN_PATH=C:/Reggie/brain
# Local machine paths. The project registry's `local_path` is only a fallback;
# set this root to use C:/Reggie/projects/<registered-project-id>.
REGGIE_PROJECT_CLONE_ROOT=C:/Reggie/projects
REGGIE_WORKTREE_ROOT=C:/Reggie/worktrees
REGGIE_STATE_ROOT=C:/Reggie/state
# Optional. Defaults to `codex` on PATH.
CODEX_BIN=codex
